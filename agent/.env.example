# NetWatch Agent — Environment Configuration
# Copy this file to .env and adjust for your network

# Polling interval in seconds (default: 30)
NETWATCH_INTERVAL=30

# Subnet to scan — leave blank to auto-detect from the host's active interface
# Example: 192.168.1.0/24
NETWATCH_SUBNET=

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
