# NetWatch Backend — Environment Configuration

# Server Port
PORT=3000

# Database Path (defaults to ./data/netwatch.db)
DB_PATH=./data/netwatch.db

# Allowed CORS origins (comma-separated, e.g., http://localhost:3001)
# 3001 is common for Next.js if 3000 is taken, or both can be allowed.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Data Retention (in days, e.g., 30). Used in later phases for pruning.
NETWATCH_RETENTION_DAYS=30
